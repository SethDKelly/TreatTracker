# Copy to terraform.tfvars (gitignored) or set via CI / defaults.

aws_region  = "us-east-2"
environment = "dev"
name_prefix = "treattracker-dev"

# SkellyHouse DNS (defaults also set in variables.tf)
domain_name      = "treattracker.skellyhouse.com"
hosted_zone_name = "skellyhouse.com"
# hosted_zone_id = "ZXXXXXXXXXXXXX"  # optional; looked up from hosted_zone_name when empty

db_name        = "treattracker"
aurora_min_acu = 0.5
aurora_max_acu = 2
